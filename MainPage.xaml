<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyFirstApp.MainPage"
             Background="#F4F1EA"
             Title="Workday Timer">

    <Grid>
        <ScrollView>
        <VerticalStackLayout
            Padding="24,36"
            Spacing="20">

            <Label
                Text="Clock Out"
                FontSize="36"
                FontAttributes="Bold"
                TextColor="#172121"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Choose when work ends, then let the clock do the watching."
                FontSize="17"
                TextColor="#455252" />

            <Border
                Padding="20"
                Background="#FFFFFF"
                Stroke="#CED5D2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="14">
                    <Label
                        Text="Finish time"
                        FontAttributes="Bold"
                        TextColor="#172121" />

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <Border
                            Grid.Column="0"
                            Padding="12,4"
                            Background="#F7F9F8"
                            Stroke="#9FB0AB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6">
                            <Picker
                                x:Name="HourPicker"
                                AutomationId="HourPicker"
                                Background="Transparent"
                                TextColor="#172121"
                                FontSize="22"
                                HorizontalOptions="Fill" />
                        </Border>

                        <Label
                            Grid.Column="1"
                            Text=":"
                            FontSize="26"
                            FontAttributes="Bold"
                            TextColor="#172121"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="2"
                            Padding="12,4"
                            Background="#F7F9F8"
                            Stroke="#9FB0AB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 6">
                            <Picker
                                x:Name="MinutePicker"
                                AutomationId="MinutePicker"
                                Background="Transparent"
                                TextColor="#172121"
                                FontSize="22"
                                HorizontalOptions="Fill" />
                        </Border>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#E2E8E5"
                        HorizontalOptions="Fill" />

                    <Button
                        x:Name="StartButton"
                        AutomationId="StartButton"
                        Text="Start countdown"
                        Background="#087E65"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="6"
                        Clicked="OnStartClicked"
                        HorizontalOptions="Fill" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="24"
                Background="#172121"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="TIME REMAINING"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#BFD9D2"
                        CharacterSpacing="2" />

                    <Label
                        x:Name="CountdownLabel"
                        AutomationId="CountdownLabel"
                        Text="00:00:00"
                        FontSize="42"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="StatusLabel"
                        AutomationId="StatusLabel"
                        Text="Pick a time to begin."
                        FontSize="15"
                        TextColor="#D8E6E2"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Label
                x:Name="CompletedCountLabel"
                AutomationId="CompletedCountLabel"
                Text="Completed workdays: 0"
                FontSize="15"
                TextColor="#455252"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
