<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyFirstApp.Models"
             xmlns:viewModels="clr-namespace:MyFirstApp.ViewModels"
             x:Class="MyFirstApp.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             Title="After Work Countdown">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <VerticalStackLayout Spacing="8">
                <Label Text="After Work Countdown"
                       FontSize="32"
                       FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="A simple .NET MAUI starter app for learning variables, if/else logic, classes, inheritance, loops, and persistence."
                       FontSize="16"
                       TextColor="{StaticResource DarkGray}" />
            </VerticalStackLayout>

            <Border Stroke="{StaticResource LightGray}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource White}"
                    Padding="20">
                <VerticalStackLayout Spacing="16">
                    <Label Text="When does the workday end?"
                           FontSize="20"
                           FontAttributes="Bold" />

                    <TimePicker Time="{Binding SelectedFinishTime}"
                                Format="HH:mm" />

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Start countdown"
                                Command="{Binding StartCountdownCommand}" />
                        <Button Text="Stop"
                                Command="{Binding StopCountdownCommand}"
                                BackgroundColor="{StaticResource LightGray}"
                                TextColor="{StaticResource Black}" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding SavedSelectionText}"
                           FontAttributes="Italic"
                           TextColor="{StaticResource DarkGray}" />

                    <Label Text="{Binding CountdownText}"
                           FontSize="40"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding StatusMessage}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="12">
                <Label Text="Learning topics built into this starter"
                       FontSize="20"
                       FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding LearningTopics}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LearningTopic">
                            <Border Stroke="{StaticResource LightGray}"
                                    StrokeThickness="1"
                                    BackgroundColor="{StaticResource White}"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="18" />
                                    <Label Text="{Binding Description}"
                                           TextColor="{StaticResource DarkGray}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
